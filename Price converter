<!DOCTYPE html>
<html lang="en">
<head> 
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custom Live Price Converter</title>
    <style>
        /* --- Customized Modern CSS UI --- */
        body { 
            font-family: system-ui, -apple-system, sans-serif; 
            background: #eef2f5; 
            display: flex; 
            justify-content: center; 
            align-items: center;
            height: 100vh;
            margin: 0; 
        }
        .converter-card { 
            background: white; 
            padding: 2.5rem; 
            border-radius: 16px; 
            box-shadow: 0 10px 30px rgba(0,0,0,0.08); 
            width: 100%; 
            max-width: 420px; 
        }
        h2 { margin-top: 0; text-align: center; color: #2d3748; font-weight: 600; }
        .input-group { margin-bottom: 1.2rem; display: flex; flex-direction: column; }
        label { margin-bottom: 0.4rem; font-size: 0.9rem; color: #4a5568; font-weight: 500; }
        input, select { 
            padding: 0.85rem; 
            border: 1.5px solid #e2e8f0; 
            border-radius: 8px; 
            font-size: 1rem; 
            color: #2d3748;
            outline: none;
            transition: border-color 0.2s;
        }
        input:focus, select:focus { border-color: #3182ce; }
        .row { display: flex; gap: 1rem; align-items: center; margin-bottom: 0.5rem; }
        .row > div { flex: 1; margin-bottom: 0; }
        
        .swap-btn { 
            background: #edf2f7; 
            color: #4a5568;
            border: none; 
            cursor: pointer; 
            border-radius: 50%; 
            width: 45px; 
            height: 45px; 
            margin-top: 1.5rem; 
            font-size: 1.2rem;
            transition: background 0.2s, transform 0.2s; 
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .swap-btn:hover { background: #e2e8f0; transform: rotate(180deg); }
        
        .convert-btn { 
            width: 100%; 
            background: #3182ce; 
            color: white; 
            border: none; 
            padding: 1rem;
            border-radius: 8px;
            cursor: pointer; 
            font-size: 1.1rem;
            font-weight: 600; 
            margin-top: 1rem; 
            transition: background 0.2s; 
        }
        .convert-btn:hover { background: #2b6cb0; }
        
        .result { margin-top: 1.8rem; font-size: 1.2rem; font-weight: 500; text-align: center; color: #4a5568; }
        .result span { font-size: 2rem; font-weight: 700; color: #3182ce; display: block; margin-top: 0.5rem;}
        .loader { text-align: center; font-size: 0.9rem; color: #718096; display: none; margin-top: 1rem; }
    </style>
</head>
<body>
    <div class="converter-card">
        <h2>Price Converter</h2>
        
        <div class="input-group">
            <label for="amount">Amount</label>
            <input type="number" id="amount" value="1" min="0" step="any">
        </div>
        
        <div class="row">
            <div class="input-group">
                <label for="fromCurrency">From</label>
                <select id="fromCurrency"></select>
            </div>
            
            <button class="swap-btn" id="swapBtn" title="Swap Currencies">⇅</button>
            
            <div class="input-group">
                <label for="toCurrency">To</label>
                <select id="toCurrency"></select>
            </div>
        </div>
        
        <button class="convert-btn" id="convertBtn">Convert Price</button>
        <div class="loader" id="loader">Fetching live rates...</div>
        <div class="result" id="resultText"></div>
    </div>

    <script>
        // --- API Integration & Logic ---
        const amountInput = document.getElementById('amount');
        const fromSelect = document.getElementById('fromCurrency');
        const toSelect = document.getElementById('toCurrency');
        const resultText = document.getElementById('resultText');
        const convertBtn = document.getElementById('convertBtn');
        const swapBtn = document.getElementById('swapBtn');
        const loader = document.getElementById('loader');

        // Using Frankfurter API (Free, Open-Source, No API Key Required)
        const API_BASE = 'https://api.frankfurter.app';

        // 1. Fetch available currencies to populate the dropdowns dynamically
        async function loadCurrencies() {
            try {
                const res = await fetch(`${API_BASE}/currencies`);
                const data = await res.json();
                
                // Create HTML <option> elements from the JSON response
                const options = Object.entries(data)
                    .map(([code, name]) => `<option value="${code}">${code} - ${name}</option>`)
                    .join('');
                
                fromSelect.innerHTML = options;
                toSelect.innerHTML = options;
                
                // Set default currencies (e.g., USD to INR)
                fromSelect.value = 'USD';
                toSelect.value = 'INR';
            } catch (error) {
                resultText.innerHTML = "<span style='color: red; font-size:1rem;'>Failed to load currencies. Check connection.</span>";
            }
        }

        // 2. Fetch the live exchange rate and calculate the total
        async function convertCurrency() {
            const amount = amountInput.value;
            const from = fromSelect.value;
            const to = toSelect.value;

            // Handle edge cases
            if (amount === '' || amount <= 0) {
                resultText.innerHTML = "<span style='font-size:1rem;'>Please enter a valid amount</span>";
                return;
            }
            if (from === to) {
                resultText.innerHTML = `${amount} ${from} = <span>${amount} ${to}</span>`;
                return;
            }

            // Show loading state
            loader.style.display = 'block';
            resultText.innerHTML = '';

            try {
                // API call for specific conversion amount
                const res = await fetch(`${API_BASE}/latest?amount=${amount}&from=${from}&to=${to}`);
                if (!res.ok) throw new Error('Network response was not ok');
                const data = await res.json();
                
                // Extract the converted rate
                const convertedAmount = data.rates[to].toFixed(2); 
                
                // Display result
                resultText.innerHTML = `${amount} ${from} = <span>${convertedAmount} ${to}</span>`;
            } catch (error) {
                resultText.innerHTML = "<span style='color: red; font-size:1rem;'>Error fetching conversion rates.</span>";
            } finally {
                // Hide loading state
                loader.style.display = 'none';
            }
        }

        // 3. Swap button logic
        swapBtn.addEventListener('click', () => {
            const temp = fromSelect.value;
            fromSelect.value = toSelect.value;
            toSelect.value = temp;
            convertCurrency(); // Auto-convert after swapping
        });

        // 4. Event Listeners
        convertBtn.addEventListener('click', convertCurrency);
        // Optional: Trigger conversion when pressing 'Enter' in the amount field
        amountInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') convertCurrency();
        });
        
        // Initialize the app on load
        loadCurrencies().then(convertCurrency);
    </script>
</body>
</html> 
